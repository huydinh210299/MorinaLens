<div class="page-head">
  <div><p class="eyebrow">Kho hàng</p><h1>Nhập, xuất, hoàn hàng</h1><p class="muted">Mỗi phiếu có thể chứa nhiều SKU. Nhập và hoàn cộng tồn; xuất trừ tồn.</p></div>
  <div class="actions"><% if (currentUser.role === 'admin') { %><a class="button secondary" href="/inventory/closing">Chốt ngày và Ads</a><% } %><a class="button" href="/inventory/new">Tạo phiếu kho</a></div>
</div>
<section class="panel">
  <p class="muted">Mọi phiếu nhập, xuất và hoàn của admin hoặc nhân viên đều chờ duyệt. Tồn kho cập nhật ngay; quản trị viên chốt cuối ngày và nhập tiền quảng cáo thực tế. Phiếu kho không tự cộng công.</p>
  <form method="get" class="filter">
    <label>Loại phiếu<select name="type"><option value="">Tất cả</option><option value="import" <%= type === 'import' ? 'selected' : '' %>>Nhập</option><option value="export" <%= type === 'export' ? 'selected' : '' %>>Xuất</option><option value="return" <%= type === 'return' ? 'selected' : '' %>>Hoàn hàng</option></select></label>
    <label>Sàn<select name="platform"><option value="">Cả hai sàn</option><option value="shopee" <%= platform === 'shopee' ? 'selected' : '' %>>Shopee</option><option value="tiktok" <%= platform === 'tiktok' ? 'selected' : '' %>>TikTok</option></select></label>
    <label>Duyệt<select name="status"><option value="">Tất cả</option><option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Chờ duyệt</option><option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Đã duyệt</option></select></label>
    <button class="button secondary">Lọc</button>
  </form>
  <div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Loại / Sàn</th><th>Sản phẩm</th><th>Người tạo</th><th>Duyệt</th><th>Tạo / Cập nhật</th><% if (currentUser.role === 'admin') { %><th>Thao tác</th><% } %></tr></thead><tbody>
    <% for (const item of items) { %>
      <tr>
        <td><%= dateOnly(item.date) %></td>
        <td><span class="badge <%= item.type %>"><%= { import: 'Nhập', export: 'Xuất', return: 'Hoàn hàng' }[item.type] %></span><br><small><%= item.platform === 'tiktok' ? 'TikTok' : 'Shopee' %></small><% if (item.source === 'product_update') { %><br><small class="muted">Điều chỉnh từ sản phẩm</small><% } %></td>
        <td><% for (const row of item.items) { %><div><strong><%= row.sku %></strong> × <%= row.amount %></div><% } %><% if (item.note && (item.source === 'product_update' || item.type === 'return')) { %><small class="muted"><%= item.note %></small><% } %></td>
        <td><%= item.createdBy?.username || '—' %></td>
        <td><span class="badge <%= item.approvalStatus || 'approved' %>"><%= item.approvalStatus === 'pending' ? 'Chờ duyệt' : 'Đã duyệt' %></span><% if (item.approvedBy) { %><br><small><%= item.approvedBy.username %> · <%= dateTime(item.approvedAt) %></small><% } %></td>
        <td><small>Tạo: <%= dateTime(item.createdAt) %><br>Cập nhật: <%= dateTime(item.updatedAt) %></small></td>
        <% if (currentUser.role === 'admin') { %><td class="actions-cell">
          <% if (item.approvalStatus === 'pending') { %><a href="/inventory/closing?date=<%= dateInput(item.date) %>">Chốt ngày</a><% } %>
          <a href="/inventory/<%= item._id %>/edit">Chỉnh sửa</a>
          <form method="post" action="/inventory/<%= item._id %>?_method=DELETE" data-confirm="Xóa phiếu và đảo số lượng tồn kho?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button danger">Xóa</button></form>
        </td><% } %>
      </tr>
    <% } %>
    <% if (!items.length) { %><tr><td colspan="<%= currentUser.role === 'admin' ? 7 : 6 %>" class="empty">Không có dữ liệu</td></tr><% } %>
  </tbody></table></div>
  <%- include('../../partials/pagination', { base: '/inventory', page, total, limit, query: [type ? 'type=' + type : '', platform ? 'platform=' + platform : '', status ? 'status=' + status : ''].filter(Boolean).join('&') }) %>
</section>
