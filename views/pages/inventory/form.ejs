<div class="page-head"><div><p class="eyebrow">Kho hàng</p><h1><%= title %></h1></div><a class="button secondary" href="/inventory">Quay lại</a></div>
<section class="panel"><form class="stack" method="post" action="<%= item ? '/inventory/' + item._id + '?_method=PUT' : '/inventory' %>" id="movement-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<p class="muted"><%= currentUser.role === 'staff' ? 'Phiếu xuất hoặc hoàn sẽ cập nhật tồn kho ngay và chờ admin duyệt. Chỉ phiếu xuất đã duyệt cộng 1 đơn tính lương.' : 'Phiếu do admin tạo được duyệt ngay.' %></p>
<div class="form-grid"><label>Loại phiếu<select name="type" required><% for (const [key, label] of [['import','Nhập'],['export','Xuất'],['return','Hoàn hàng']]) { if (currentUser.role === 'admin' || key !== 'import') { %><option value="<%= key %>" <%= (item?.type || 'export') === key ? 'selected' : '' %>><%= label %></option><% } } %></select></label><label>Ngày<input type="date" name="date" required value="<%= dateInput(item?.date) %>"></label><label>Sàn<select name="platform"><option value="shopee" <%= item?.platform !== 'tiktok' ? 'selected' : '' %>>Shopee</option><option value="tiktok" <%= item?.platform === 'tiktok' ? 'selected' : '' %>>TikTok</option></select></label></div>
<div class="section-head"><div><h2>Sản phẩm trong phiếu</h2><p class="muted">Tìm SKU trong danh sách, thêm nhiều dòng nếu cần.</p></div><button type="button" class="button secondary" id="add-item">Thêm sản phẩm</button></div>
<datalist id="sku-list"><% for (const product of products) { %><option value="<%= product.sku %>"><%= product.name %> · Tồn <%= product.quantity %></option><% } %></datalist>
<% if (currentUser.role === 'admin') { %><p class="muted">Giá bán đã gồm thuế. Doanh thu là giá sau voucher shop bằng tiền; thuế tính trên doanh thu này trước phí sàn. Ads tính trên tiền thực nhận ước tính sau phí sàn và thuế. Các khoản tiền cố định được tính cho mỗi sản phẩm. Phiếu xuất lưu giá bán, giá nhập, Ads và toàn bộ cấu hình phí tại lúc tạo phiếu. Sửa số lượng giữ nguyên dữ liệu đã lưu; đổi SKU hoặc sàn sẽ lấy cấu hình hiện tại.</p><% } %>
<div id="item-rows" data-next="<%= item?.items?.length || 1 %>"><% const rows = item?.items?.length ? item.items : [{sku:'',amount:1}]; for (let i = 0; i < rows.length; i++) { %><div class="item-row"><label>SKU<input list="sku-list" name="items[<%= i %>][sku]" required value="<%= rows[i].sku %>" autocomplete="off"></label><label>Số lượng<input type="number" name="items[<%= i %>][amount]" min="1" step="1" required value="<%= rows[i].amount %>"></label><button type="button" class="button subtle remove-item">Xóa dòng</button></div><% } %></div>
<label>Ghi chú<textarea name="note" rows="3" maxlength="500"><%= item?.note || '' %></textarea></label><div class="actions"><button class="button"><%= item ? 'Cập nhật' : 'Lưu' %></button><a class="button secondary" href="/inventory">Hủy</a></div>
</form></section>
