<div class="page-head"><div><p class="eyebrow">Quảng cáo</p><h1>Chốt Ads theo tháng</h1><p class="muted">Chọn tháng, ghi nhận từng khoản Ads và cộng dồn để tính lợi nhuận tháng.</p></div><a class="button secondary" href="/revenue?month=<%= month %>">Xem lợi nhuận tháng</a></div>
<section class="panel"><form method="get" action="/inventory/ads" class="inline-form"><label>Chọn tháng<input type="month" name="month" required value="<%= month %>"></label><button class="button secondary">Xem tháng</button></form></section>
<div class="stats"><div class="stat"><strong><%= money(totals.shopeeAds) %></strong><span>Ads Shopee tháng <%= month %></span></div><div class="stat"><strong><%= money(totals.tiktokAds) %></strong><span>Ads TikTok tháng <%= month %></span></div><div class="stat"><strong><%= money(totals.shopeeAds + totals.tiktokAds) %></strong><span>Tổng Ads tháng đã ghi nhận</span></div></div>
<section class="panel"><h2>Thêm lần chốt Ads</h2><p class="muted">Nhập số tiền phát sinh của lần này cho từng sàn; nhập 0 nếu không chạy. Mỗi lần chốt được cộng thêm vào tháng đã chọn. Ví dụ đã chốt 1.000.000đ, phát sinh thêm 500.000đ thì lần sau chỉ nhập 500.000đ.</p>
  <form method="post" action="/inventory/ads" class="stack" data-confirm="Cộng khoản Ads của lần này vào tháng đã chọn?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestId" value="<%= requestId %>">
    <label>Tháng tính chi phí Ads<input type="month" name="month" required max="<%= currentMonth %>" value="<%= month %>"></label>
    <div class="form-grid"><label>Tiền Ads Shopee lần này (₫)<input type="number" name="shopeeAds" min="0" max="1000000000000" step="1" required placeholder="Nhập 0 nếu không chạy"></label><label>Tiền Ads TikTok lần này (₫)<input type="number" name="tiktokAds" min="0" max="1000000000000" step="1" required placeholder="Nhập 0 nếu không chạy"></label></div>
    <label>Ghi chú<textarea name="note" rows="2" maxlength="500" placeholder="Ví dụ: Ads đợt 1, từ đầu tháng đến ngày 15"></textarea></label>
    <button class="button">Chốt khoản Ads</button>
  </form>
</section>
<section class="panel" id="ads-history"><h2>Lịch sử chốt Ads tháng <%= month %></h2><div class="table-wrap"><table><thead><tr><th>Thời điểm chốt</th><th>Shopee</th><th>TikTok</th><th>Tổng tiền</th><th>Người chốt</th><th>Ghi chú</th></tr></thead><tbody>
  <% for (const entry of entries) { %><tr><td><%= dateTime(entry.closedAt) %></td><td><%= money(entry.shopeeAds) %></td><td><%= money(entry.tiktokAds) %></td><td><%= money(entry.shopeeAds + entry.tiktokAds) %></td><td><%= entry.closedBy?.username || 'Quản trị viên' %></td><td><%= entry.note || '—' %></td></tr><% } %>
  <% if (!entries.length) { %><tr><td colspan="6" class="empty">Chưa có lần chốt Ads theo tháng.</td></tr><% } %>
</tbody></table></div><%- include('../../partials/pagination', { base: '/inventory/ads', page, total, limit, query: 'month=' + month, anchor: 'ads-history' }) %></section>
