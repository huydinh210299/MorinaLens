<div class="page-head"><div><p class="eyebrow">Báo cáo</p><h1>Doanh thu và lợi nhuận tháng</h1><p class="muted">Doanh thu − giá nhập và các loại phí − tiền quảng cáo thực tế theo ngày.</p></div><a class="button" href="/inventory/closing">Chốt ngày và Ads</a></div>
<section class="panel"><form method="get" class="filter"><label>Chọn tháng<input type="month" name="month" value="<%= month %>" required></label><button class="button">Xem báo cáo</button></form><p class="muted">Chỉ tính phiếu xuất đã duyệt. Giá nhập, thuế, phí sàn, đóng gói và dự phòng dùng dữ liệu lưu trong phiếu; Ads dùng số tiền thực tế đã nhập cho ngày tương ứng, không trừ thêm tỷ lệ Ads của sản phẩm. Doanh thu theo giá bán sau voucher shop, chưa phải đối soát tiền thực nhận từ sàn. Phiếu hoàn chỉ cập nhật tồn kho.</p></section>
<% if (report.totals.unclosedDays || report.pendingCount) { %><div class="alert error">Báo cáo còn tạm tính: <%= report.totals.unclosedDays %> ngày có doanh thu chưa nhập Ads thực tế; <%= report.pendingCount %> phiếu kho đang chờ duyệt. Hãy chốt các ngày còn thiếu để hoàn tất số liệu.</div><% } %>
<div class="stats"><div class="stat"><strong><%= money(report.totals.revenue) %></strong><span>Doanh thu theo phiếu đã duyệt</span></div><div class="stat"><strong><%= money(report.totals.costBeforeAds) %></strong><span>Giá nhập và các loại phí, chưa gồm Ads</span></div><div class="stat"><strong><%= money(report.totals.adsCost) %></strong><span>Tiền quảng cáo thực tế đã ghi nhận</span></div><div class="stat"><strong class="<%= report.totals.profit >= 0 ? 'positive' : 'negative' %>"><%= money(report.totals.profit) %></strong><span>Lợi nhuận sau Ads thực tế<%= report.totals.unclosedDays || report.pendingCount ? ' (tạm tính)' : '' %></span></div><div class="stat"><strong><%= report.totals.orders %></strong><span>Phiếu xuất đã duyệt · <%= report.totals.quantity %> sản phẩm có giá</span></div></div>
<% if (report.totals.unpricedItems) { %><div class="alert error"><%= report.totals.unpricedItems %> sản phẩm trong phiếu xuất cũ thiếu dữ liệu giá hoặc phí nên chưa được cộng vào doanh thu và lợi nhuận.</div><% } %>
<section class="panel"><h2>Theo sàn</h2><div class="table-wrap"><table><thead><tr><th>Sàn</th><th>Phiếu xuất</th><th>Số lượng</th><th>Doanh thu</th><th>Giá nhập và phí</th><th>Ads thực tế</th><th>Tổng chi phí</th><th>Lợi nhuận</th></tr></thead><tbody><% for (const [platform, label] of [['shopee','Shopee'],['tiktok','TikTok']]) { const row = report.byPlatform[platform]; %><tr><td><%= label %></td><td><%= row.orders %></td><td><%= row.quantity %></td><td><%= money(row.revenue) %></td><td><%= money(row.costBeforeAds) %></td><td><%= money(row.adsCost) %></td><td><%= money(row.cost) %></td><td class="<%= row.profit >= 0 ? 'positive' : 'negative' %>"><%= money(row.profit) %></td></tr><% } %></tbody></table></div></section>
<section class="panel"><h2>Theo ngày</h2><div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Phiếu xuất</th><th>Số lượng</th><th>Doanh thu</th><th>Giá nhập và phí</th><th>Ads thực tế</th><th>Lợi nhuận</th><th>Chốt ngày</th></tr></thead><tbody><% for (const row of report.byDay) { %><tr><td><%= row.day.split('-').reverse().join('/') %></td><td><%= row.orders %></td><td><%= row.quantity %></td><td><%= money(row.revenue) %></td><td><%= money(row.costBeforeAds) %></td><td><%= row.adsRecorded ? money(row.adsCost) : 'Chưa nhập' %></td><td class="<%= row.profit >= 0 ? 'positive' : 'negative' %>"><%= money(row.profit) %><% if (!row.adsRecorded) { %><br><small>Tạm tính trước Ads</small><% } %></td><td><a href="/inventory/closing?date=<%= row.day %>"><%= row.adsRecorded ? 'Xem / Cập nhật' : 'Nhập Ads và chốt' %></a></td></tr><% } %><% if (!report.byDay.length) { %><tr><td colspan="8" class="empty">Không có dữ liệu</td></tr><% } %></tbody></table></div></section>
