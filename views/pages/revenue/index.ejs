<div class="page-head"><div><p class="eyebrow">Báo cáo</p><h1>Doanh thu và lợi nhuận tháng</h1><p class="muted">Tính theo giá bán và cấu hình được lưu lúc xuất hàng. Chỉ phiếu xuất đã duyệt được tính.</p></div></div>
<section class="panel"><form method="get" class="filter"><label>Chọn tháng<input type="month" name="month" value="<%= month %>" required></label><button class="button">Xem báo cáo</button></form><p class="muted">Phiếu hoàn chỉ cộng lại tồn kho, không thay đổi doanh thu hoặc lợi nhuận. Các số liệu là dự tính từ giá sản phẩm, không phải số tiền thực nhận từ sàn.</p></section>
<div class="stats"><div class="stat"><strong><%= money(report.totals.revenue) %></strong><span>Doanh thu dự tính</span></div><div class="stat"><strong><%= money(report.totals.cost) %></strong><span>Tổng chi phí dự tính</span></div><div class="stat"><strong><%= money(report.totals.adsCost) %></strong><span>Chi phí Ads (đã gồm trong tổng chi phí)</span></div><div class="stat"><strong class="<%= report.totals.profit >= 0 ? 'positive' : 'negative' %>"><%= money(report.totals.profit) %></strong><span>Lợi nhuận dự tính</span></div><div class="stat"><strong><%= report.totals.orders %></strong><span>Phiếu xuất đã duyệt · <%= report.totals.quantity %> sản phẩm có giá</span></div></div>
<% if (report.totals.unpricedItems) { %><div class="alert error"><%= report.totals.unpricedItems %> sản phẩm trong phiếu xuất cũ chưa có ảnh chụp giá nên chưa được cộng vào tiền doanh thu và lợi nhuận.</div><% } %>
<section class="grid-two"><div class="panel"><h2>Theo sàn</h2><div class="table-wrap"><table><thead><tr><th>Sàn</th><th>Phiếu</th><th>Số lượng</th><th>Doanh thu</th><th>Chi phí</th><th>Ads trong chi phí</th><th>Lợi nhuận</th></tr></thead><tbody><% for (const [platform, label] of [['shopee','Shopee'],['tiktok','TikTok']]) { const row = report.byPlatform[platform]; %><tr><td><%= label %></td><td><%= row.orders %></td><td><%= row.quantity %></td><td><%= money(row.revenue) %></td><td><%= money(row.cost) %></td><td><%= money(row.adsCost) %></td><td class="<%= row.profit >= 0 ? 'positive' : 'negative' %>"><%= money(row.profit) %></td></tr><% } %></tbody></table></div></div>
<div class="panel"><h2>Theo ngày</h2><div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Phiếu</th><th>Số lượng</th><th>Doanh thu</th><th>Lợi nhuận</th></tr></thead><tbody><% for (const row of report.byDay) { %><tr><td><%= row.day.split('-').reverse().join('/') %></td><td><%= row.orders %></td><td><%= row.quantity %></td><td><%= money(row.revenue) %></td><td class="<%= row.profit >= 0 ? 'positive' : 'negative' %>"><%= money(row.profit) %></td></tr><% } %><% if (!report.byDay.length) { %><tr><td colspan="5" class="empty">Không có dữ liệu</td></tr><% } %></tbody></table></div></div></section>
