<div class="page-head"><div><p class="eyebrow">Báo cáo</p><h1>Doanh thu và lãi trước Ads theo tháng</h1><p class="muted">Doanh thu − giá nhập và các loại phí, chưa trừ chi phí quảng cáo.</p></div></div>
<section class="panel"><form method="get" class="filter"><label>Chọn tháng<input type="month" name="month" value="<%= month %>" required></label><button class="button">Xem báo cáo</button></form><p class="muted">Chỉ tính phiếu xuất Shopee đã duyệt. Giá nhập, thuế, phí sàn, đóng gói và dự phòng dùng dữ liệu lưu trong phiếu. Chi phí Ads thực tế được theo dõi trên Shopee; báo cáo này không trừ Ads thực tế hoặc Ads ước tính theo tỷ lệ sản phẩm. Doanh thu theo giá bán sau voucher shop, chưa phải đối soát tiền thực nhận từ sàn. Phiếu hoàn chỉ cập nhật tồn kho.</p></section>
<% if (report.pendingCount) { %><div class="alert error">Báo cáo còn tạm tính: <%= report.pendingCount %> phiếu kho đang chờ duyệt. Hãy duyệt các phiếu còn thiếu.</div><% } %>
<div class="stats"><div class="stat"><strong><%= money(report.totals.revenue) %></strong><span>Doanh thu theo phiếu đã duyệt</span></div><div class="stat"><strong><%= money(report.totals.costBeforeAds) %></strong><span>Giá nhập và các loại phí, chưa gồm Ads</span></div><div class="stat"><strong class="<%= report.totals.profit >= 0 ? 'positive' : 'negative' %>"><%= money(report.totals.profit) %></strong><span>Lãi trước Ads<%= report.pendingCount ? ' (tạm tính)' : '' %></span></div><div class="stat"><strong><%= report.totals.orders %></strong><span>Phiếu xuất đã duyệt · <%= report.totals.quantity %> sản phẩm có giá</span></div></div>
<% if (report.totals.unpricedItems) { %><div class="alert error"><%= report.totals.unpricedItems %> sản phẩm trong phiếu xuất cũ thiếu dữ liệu giá hoặc phí nên chưa được cộng vào doanh thu và lãi trước Ads.</div><% } %>
<section class="panel"><h2>Theo sàn</h2><div class="table-wrap"><table><thead><tr><th>Sàn</th><th>Phiếu xuất</th><th>Số lượng</th><th>Doanh thu</th><th>Giá nhập và phí</th><th>Lãi trước Ads</th></tr></thead><tbody><% for (const [platform, label] of [['shopee','Shopee']]) { const row = report.byPlatform[platform]; %><tr><td><%= label %></td><td><%= row.orders %></td><td><%= row.quantity %></td><td><%= money(row.revenue) %></td><td><%= money(row.costBeforeAds) %></td><td class="<%= row.profit >= 0 ? 'positive' : 'negative' %>"><%= money(row.profit) %></td></tr><% } %></tbody></table></div></section>
<section class="panel" id="daily-revenue"><h2>Doanh thu theo ngày</h2><p class="muted">Lãi trước Ads = doanh thu − giá nhập và phí.</p><div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Phiếu xuất</th><th>Số lượng</th><th>Doanh thu</th><th>Giá nhập và phí</th><th>Lãi trước Ads</th><th>Phiếu kho</th></tr></thead><tbody><% for (const row of dailyPage.items) { %><tr><td><%= row.day.split('-').reverse().join('/') %></td><td><%= row.orders %></td><td><%= row.quantity %></td><td><%= money(row.revenue) %></td><td><%= money(row.costBeforeAds) %></td><td class="<%= row.profit >= 0 ? 'positive' : 'negative' %>"><%= money(row.profit) %></td><td><a href="/inventory?date=<%= row.day %>">Xem / Duyệt phiếu</a></td></tr><% } %><% if (!dailyPage.items.length) { %><tr><td colspan="7" class="empty">Không có dữ liệu</td></tr><% } %></tbody></table></div><%- include('../../partials/pagination', { ...dailyPage, base: '/revenue', query: 'month=' + month, anchor: 'daily-revenue' }) %></section>
