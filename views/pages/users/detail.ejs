<div class="page-head">
  <div><p class="eyebrow">Nhân sự</p><h1><%= item.username %></h1><p class="muted"><%= item.role === 'admin' ? 'Quản trị' : 'Nhân viên' %> · <%= item.active ? 'Đang hoạt động' : 'Đã khóa' %></p></div>
  <div class="actions"><a class="button secondary" href="/users">Quay lại</a><a class="button" href="/users/<%= item._id %>/edit">Chỉnh sửa</a></div>
</div>
<% if (item.payroll?.length) { %>
<section class="panel" id="payroll-history"><details <%= payrollHistory.page > 1 ? 'open' : '' %>><summary>Lịch sử lương cũ</summary>
  <div class="table-wrap"><table><thead><tr><th>Tháng</th><th>Lương cũ</th><th>Đã thanh toán</th><th>Lịch sử thanh toán</th></tr></thead><tbody>
    <% for (const row of payrollHistory.items) { %>
      <tr><td><%= row.month %></td><td><%= money(row.amount) %></td><td><%= money(row.paidTotal) %></td><td><% for (const payment of row.payments || []) { %><div><%= money(payment.amount) %> · <%= dateTime(payment.paidAt) %> · <%= payment.paidBy?.username || 'Admin' %></div><% } %><% if (row.note) { %><small><%= row.note %></small><% } %></td></tr>
    <% } %>
  </tbody></table></div>
  <%- include('../../partials/pagination', { ...payrollHistory, base: historyBase, query: '', pageParam: 'payrollPage', anchor: 'payroll-history' }) %>
</details></section>
<% } %>
