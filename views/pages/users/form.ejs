<div class="page-head"><div><p class="eyebrow">Nhân sự</p><h1><%= title %></h1></div><a class="button secondary" href="/users">Quay lại</a></div>
<section class="panel"><form class="stack" method="post" action="<%= item ? '/users/' + item._id + '?_method=PUT' : '/users' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><label>Tên đăng nhập<input name="username" required maxlength="60" value="<%= item?.username || '' %>"></label><label>Mật khẩu <%= item ? '(để trống nếu giữ nguyên)' : '' %><input type="password" name="password" <%= item ? '' : 'required' %> autocomplete="new-password"></label><label>Vai trò<select name="role"><option value="staff" <%= item?.role !== 'admin' ? 'selected' : '' %>>Nhân viên</option><option value="admin" <%= item?.role === 'admin' ? 'selected' : '' %>>Quản trị</option></select></label><label class="check"><input type="checkbox" name="active" <%= !item || item.active ? 'checked' : '' %>> Đang hoạt động</label></div><div class="actions"><button class="button"><%= item ? 'Cập nhật' : 'Lưu' %></button><a class="button secondary" href="/users">Hủy</a></div></form></section>
