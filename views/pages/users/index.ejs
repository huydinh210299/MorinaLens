<div class="page-head"><div><p class="eyebrow">Nhân sự</p><h1>Nhân viên</h1><p class="muted">Quản lý tài khoản, số đơn đã đóng và lương theo tháng.</p></div><a class="button" href="/users/new">Thêm nhân viên</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Tên đăng nhập</th><th>Vai trò</th><th>Trạng thái</th><th>Tổng đơn đã đóng</th><th>Tạo / Cập nhật</th><th>Thao tác</th></tr></thead><tbody>
<% for (const item of items) { %><tr><td><a href="/users/<%= item._id %>"><strong><%= item.username %></strong></a></td><td><%= item.role === 'admin' ? 'Quản trị' : 'Nhân viên' %></td><td><%= item.active ? 'Đang hoạt động' : 'Đã khóa' %></td><td><%= (item.orders || []).reduce((sum, row) => sum + row.amount, 0) %></td><td><small>Tạo: <%= dateTime(item.createdAt) %><br>Cập nhật: <%= dateTime(item.updatedAt) %></small></td><td class="actions-cell"><a href="/users/<%= item._id %>">Chi tiết</a><a href="/users/<%= item._id %>/edit">Chỉnh sửa</a><form method="post" action="/users/<%= item._id %>?_method=DELETE" data-confirm="Xóa tài khoản này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button danger">Xóa</button></form></td></tr><% } %><% if (!items.length) { %><tr><td colspan="6" class="empty">Không có dữ liệu</td></tr><% } %>
</tbody></table></div><%- include('../../partials/pagination', { base: '/users', page, total, limit, query: '' }) %></section>
