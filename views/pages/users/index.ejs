<div class="page-head"><div><p class="eyebrow">Nhân sự</p><h1>Nhân viên</h1><p class="muted">Quản lý tài khoản và chốt hoa hồng theo doanh thu từng tháng.</p></div><div class="actions"><a class="button" href="/users/new">Thêm nhân viên</a></div></div>
<section class="panel">
  <form method="get" class="inline-form"><label>Tháng hoa hồng<input type="month" name="month" value="<%= month %>" required></label><button class="button secondary">Xem</button></form>
  <div class="table-wrap"><table><thead><tr><th>Tên đăng nhập</th><th>Vai trò</th><th>Trạng thái</th><th>Doanh thu tháng</th><th>Tỷ lệ</th><th>Hoa hồng</th><th>Chốt tháng</th><th>Thao tác</th></tr></thead><tbody>
  <% for (const item of items) { %><tr>
    <td><a href="/users/<%= item._id %>?month=<%= month %>"><strong><%= item.username %></strong></a></td><td><%= item.role === 'admin' ? 'Quản trị' : 'Nhân viên' %></td><td><%= item.active ? 'Đang hoạt động' : 'Đã khóa' %></td>
    <td><%= item.role === 'staff' ? money(item.commission.revenue) : '—' %></td><td><%= item.role === 'staff' ? item.commission.percent + '%' : '—' %></td><td><%= item.role === 'staff' ? money(item.commission.amount) : '—' %></td><td><%= item.role === 'staff' ? (item.commission.closed ? 'Đã chốt' : 'Tạm tính') : '—' %></td>
    <td class="actions-cell"><a href="/users/<%= item._id %>?month=<%= month %>"><%= item.role === 'staff' && !item.commission.closed ? 'Xem và chốt' : 'Chi tiết' %></a><a href="/users/<%= item._id %>/edit">Chỉnh sửa</a><form method="post" action="/users/<%= item._id %>?_method=DELETE" data-confirm="Xóa tài khoản này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button danger">Xóa</button></form></td>
  </tr><% } %><% if (!items.length) { %><tr><td colspan="8" class="empty">Không có dữ liệu</td></tr><% } %>
  </tbody></table></div><%- include('../../partials/pagination', { base: '/users', page, total, limit, query: 'month=' + month }) %>
</section>
