<% if (total > limit) { const max = Math.ceil(total / limit); %><nav class="pagination" aria-label="Phân trang"><span>Trang <%= page %> / <%= max %> · <%= total %> bản ghi</span><% if (page > 1) { %><a href="<%= base %>?page=<%= page - 1 %><%= query ? '&' + query : '' %>">Trước</a><% } %><% if (page < max) { %><a href="<%= base %>?page=<%= page + 1 %><%= query ? '&' + query : '' %>">Sau</a><% } %></nav><% } %>
